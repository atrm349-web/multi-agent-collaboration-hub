# ==============================================================================
# Multi-Agent Collaboration Hub (Agent Router) — 环境变量模板
# 复制本文件为 .env.local 并填入你的 API Key 即可开启实机多模型协同能力。
# 如不配置，系统将默认以极简演示 / 模拟模式（Mock Mode）运行，开箱即用。
# ==============================================================================

# 1. DeepSeek 官方 API（用于推理拆解与代码生成）
# 申请地址: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 2. Google Gemini / Antigravity API（用于接口基线校验与多模态分析）
# 申请地址: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 3. 腾讯 WorkBuddy 智能体服务（本地或局域网网关）
# 默认本地网关端口 18492
WORKBUDDY_GATEWAY_URL=http://127.0.0.1:18492

# 4. OpenAI / ChatGPT Plus 会员直连（可选）
# 如果安装了官方 ChatGPT 桌面应用或 codex-cli，将自动识别登录态
# 也可通过标准 API Key 方式直连
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# 5. 服务端运行参数（可选）
PORT=4321
HUB_MAX_CONCURRENCY=2
