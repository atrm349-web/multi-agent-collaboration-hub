+  expect(live).toContain("LIVE CURRENT"); expect(live).toContain("LIVE RUN"); expect(live).toContain("LIVE ARTIFACT");
+  expect(live).not.toContain("MOCK CURRENT"); expect(live).not.toContain("data-mock-step");
