import { createHash, randomUUID } from "node:crypto";
import type { HubStore } from "./state/store.ts";
import type { AcceptanceCriterion, AgentRun, Approval, Artifact, Subtask, Task, Validation } from "../shared/src/types.ts";

function fail(code: string, message: string): never { throw new Error(`${code}: ${message}`); }
function canonical(value: unknown): string {
  if (Array.isArray(value)) return `[${value.map(canonical).join(",")}]`;
  if (value && typeof value === "object") return `{${Object.keys(value).sort().map((key) => `${JSON.stringify(key)}:${canonical((value as Record<string, unknown>)[key])}`).join(",")}}`;
  return JSON.stringify(value) ?? "null";
}
function rows<T>(store: HubStore, kind: string, taskId: string): T[] {
  return store.db.query<{ data: string }, [string, string]>("SELECT data FROM hub_entities WHERE kind=? AND task_id=? ORDER BY created_at,id")
    .all(kind, taskId).map((row) => JSON.parse(row.data));
}

export function extractReviewJson(rawText: string): { approved: boolean; findings: string[] } {
  if (Buffer.byteLength(rawText) > 64000) throw new Error("ACCEPTANCE_FAILED: review exceeds limit");
  type Review = {approved: boolean; findings: string[]};
  const reviews: Review[] = [];
  let parsedAnyJson = false;
  const accept = (source: string) => {
    let parsed: unknown;
    try { parsed = JSON.parse(source); } catch { return; }
    parsedAnyJson = true;
    if (!parsed || typeof parsed !== "object" || Array.isArray(parsed)) return;
    const value = parsed as Record<string,unknown>;
    if (typeof value.approved === "boolean" && Array.isArray(value.findings) && value.findings.every((item) => typeof item === "string")) {
      reviews.push({approved:value.approved,findings:value.findings});
    }
  };
  const trimmed = rawText.trim();
  accept(trimmed);
  if (parsedAnyJson) {
    if (reviews.length === 1) return reviews[0]!;
    throw new Error("ACCEPTANCE_FAILED: malformed review");
  }
  // Scan complete top-level objects once, ignoring braces inside JSON strings.
  let depth = 0;
  let start = 0;
  let quoted = false;
  let escaped = false;
  for (let index = 0; index < trimmed.length; index++) {
    const char = trimmed[index];
    if (quoted) {
      if (escaped) escaped = false;
      else if (char === "\\") escaped = true;
      else if (char === '"') quoted = false;
    } else if (depth > 0 && char === '"') quoted = true;
    else if (char === "{") { if (depth === 0) start = index; depth++; }
    else if (char === "}" && depth > 0) {
      depth--;
      if (depth === 0) accept(trimmed.slice(start,index+1));
    }
  }
  if (reviews.length > 1) throw new Error("ACCEPTANCE_FAILED: ambiguous review contains multiple verdicts");
  if (reviews.length === 1) return reviews[0]!;
  if (parsedAnyJson) throw new Error("ACCEPTANCE_FAILED: malformed review");
  throw new Error("ACCEPTANCE_FAILED: reviewer returned invalid JSON");
}
export interface FinalDelivery {
  task: Task; review: Subtask; reviewRun: AgentRun;
  subtasks: Subtask[]; runs: AgentRun[]; artifacts: Artifact[]; validations: Validation[]; digest: string;
}

/** Pure database capture, shared by the asynchronous verifier and final atomic transition. */
export function captureFinalDelivery(store: HubStore, taskId: string, reviewSubtaskId: string, finalizing = false): FinalDelivery {
  const task = store.get("task", taskId);
  if (task.executionMode !== "live" || task.provenance !== "current" || !["running", "waiting_approval"].includes(task.status)) fail("UNSUPPORTED_TRANSITION", "Task is not awaiting a live final delivery");
  if (task.deadlineAt !== null && Date.parse(task.deadlineAt) <= Date.now()) fail("TIMEOUT", "Task deadline has expired");
  const subtasks = rows<Subtask>(store, "subtask", taskId);
  if (!subtasks.length || subtasks.length > 100) fail("ACCEPTANCE_FAILED", "Final delivery needs a bounded complete subtask graph");
  const review = subtasks.find((step) => step.id === reviewSubtaskId);
  if (!review || review.stage !== "review" || !(review.status === "waiting_approval" || (finalizing && review.status === "succeeded"))) fail("UNSUPPORTED_TRANSITION", "Independent review is not ready for approval");
  if (subtasks.some((step) => step.executionMode !== "live" || (step.id !== review.id && step.status !== "succeeded"))) fail("ACCEPTANCE_FAILED", "Every preceding subtask must succeed");
  const allRuns = rows<AgentRun>(store, "run", taskId);
  const runs = subtasks.map((step) => {
    const candidates = allRuns.filter((run) => run.subtaskId === step.id).sort((a, b) => b.attempt - a.attempt || b.createdAt.localeCompare(a.createdAt) || b.id.localeCompare(a.id));
    const run = candidates[0];
    if (!run || run.attempt !== step.attempt || run.status !== "succeeded" || run.exitCode !== 0 || run.error !== null || run.executionMode !== "live" || run.provenance !== "current" || !run.providerSessionId) fail("ACCEPTANCE_FAILED", "Current subtask attempt lacks a successful real run");
    return run;
  });
  const reviewRun = runs.find((run) => run.subtaskId === review.id)!;
  if (runs.some((run) => run.id !== reviewRun.id && run.providerSessionId === reviewRun.providerSessionId)) fail("ACCEPTANCE_FAILED", "Review must use a separate provider session");
  if (!reviewRun.startedAt || runs.some((run) => run.id !== reviewRun.id && (!run.endedAt || Date.parse(run.endedAt) > Date.parse(reviewRun.startedAt!)))) fail("ACCEPTANCE_FAILED", "Review must follow the current upstream executions");
  const reviewLogs = store.db.query<{ data: string }, [string]>("SELECT data FROM hub_logs WHERE run_id=? ORDER BY log_seq").all(reviewRun.id);
  let verdictText: string | null = null;
  for (const log of reviewLogs) {
    const event = JSON.parse(log.data).raw?.event;
    if (event?.type === "item.completed" && event.item?.type === "agent_message" && typeof event.item.text === "string") verdictText = event.item.text;
  }
  let verdict: { approved: boolean; findings: string[] };
  try {
    if (verdictText === null) throw new Error("missing verdict");
    verdict = extractReviewJson(verdictText);
  } catch { fail("ACCEPTANCE_FAILED", "Review verdict is not structured JSON"); }
  if (verdict.approved !== true) fail("ACCEPTANCE_FAILED", "Independent reviewer did not approve the current work");
  const allValidations = rows<Validation>(store, "validation", taskId);
  const required = new Map<string, { step: Subtask; criterion: AcceptanceCriterion }>();
  const requireCriterion = (step: Subtask, criterion: AcceptanceCriterion) => {
    if (!criterion || typeof criterion.id !== "string" || !criterion.id || typeof criterion.description !== "string" || !criterion.description.trim()) fail("ACCEPTANCE_FAILED", "Acceptance criteria must be explicit");
    const key = `${step.id}:${criterion.id}`; const existing = required.get(key);
    if (existing && canonical(existing.criterion) !== canonical(criterion)) fail("ACCEPTANCE_FAILED", "Criterion identifier has conflicting definitions");
    required.set(key, { step, criterion });
  };
  for (const step of subtasks) for (const criterion of step.acceptanceCriteria) requireCriterion(step, criterion);
  for (const criterion of task.acceptanceCriteria) requireCriterion(review, criterion);
  if (!required.size) fail("ACCEPTANCE_FAILED", "At least one actual acceptance test is required");
  const validationMap = new Map<string, Validation>();
  for (const { step, criterion } of required.values()) {
    const run = runs.find((item) => item.subtaskId === step.id)!;
    const matches = allValidations.filter((check) => check.subtaskId === step.id && check.runId === run.id && check.criterionId === criterion.id);
    if (!matches.length || matches.some((check) => check.status !== "passed" || check.exitCode !== 0 || check.executionMode !== "live" || check.provenance !== "current" || !check.evidenceArtifactIds.length)) fail("ACCEPTANCE_FAILED", "Current run lacks passing acceptance evidence; failed tests require a new attempt");
    for (const check of matches) validationMap.set(check.id, check);
  }
  const validations = [...validationMap.values()].sort((a, b) => a.id.localeCompare(b.id));
  const artifactIds = new Set(subtasks.flatMap((step) => step.outputArtifactIds));
  for (const validation of validations) for (const id of validation.evidenceArtifactIds) artifactIds.add(id);
  if (!artifactIds.size) fail("ACCEPTANCE_FAILED", "Final delivery requires immutable artifacts");
  const artifacts = [...artifactIds].sort().map((id) => {
    const artifact = store.get("artifact", id); const run = runs.find((item) => item.subtaskId === artifact.subtaskId);
    if (artifact.taskId !== taskId || !run || artifact.producerRunId !== run.id || artifact.validationStatus !== "validated" || artifact.executionMode !== "live" || artifact.provenance !== "current" || !/^[a-f0-9]{64}$/i.test(artifact.sha256)) fail("ARTIFACT_INVALID", "Artifact does not belong to the current validated attempt");
    return artifact;
  });
  const binding = {
    task: { id: task.id, title: task.title, goal: task.goal, repositoryId: task.repositoryId, baseCommit: task.baseCommit, acceptanceCriteria: task.acceptanceCriteria, deadlineAt: task.deadlineAt },
    subtasks: subtasks.map(({ status: _status, version: _version, updatedAt: _updated, progressPct: _progress, error: _error, ...step }) => step),
    runs, artifacts, validations,
    reviewMessageHash: createHash("sha256").update(verdictText!).digest("hex"),
  };
  return { task, review, reviewRun, subtasks, runs, artifacts, validations, digest: createHash("sha256").update(canonical(binding)).digest("hex") };
}

export class QualityGate {
  constructor(private readonly store: HubStore, private readonly options: { verifyArtifact: (artifact: Artifact) => Promise<void> }) {}

  async openFinalApproval(taskId: string, reviewSubtaskId: string): Promise<Approval> {
    let initial: FinalDelivery;
    try {
      initial = this.store.snapshot(() => captureFinalDelivery(this.store, taskId, reviewSubtaskId)).data;
      await this.verify(initial.artifacts);
    } catch (error) { this.invalidateTaskApprovals(taskId); throw error; }
    return this.store.db.transaction(() => {
      const current = captureFinalDelivery(this.store, taskId, reviewSubtaskId);
      if (current.digest !== initial.digest) fail("CONFLICT", "Delivery changed during artifact verification");
      const approvals = rows<Approval>(this.store, "approval", taskId);
      if (approvals.some((approval) => approval.status === "pending" && approval.actionType !== "final_delivery")) fail("UNSUPPORTED_TRANSITION", "Another approval is still pending");
      let reusable: Approval | undefined;
      for (const approval of approvals) {
        if (approval.status !== "pending") continue;
        if (Date.parse(approval.expiresAt) <= Date.now()) this.store.put("approval", { ...approval, status: "expired" }, approval.version);
        else if (approval.actionDigest === current.digest && approval.subtaskId === current.review.id && this.sameRefs(approval, current)) reusable ??= approval;
        else this.store.put("approval", { ...approval, status: "invalidated" }, approval.version);
      }
      if (reusable) return reusable;
      if (approvals.some((approval) => approval.status === "rejected" && approval.actionDigest === current.digest)) fail("UNSUPPORTED_TRANSITION", "Rejected content requires rework before a new approval");
      const now = new Date().toISOString();
      const approval = this.store.put("approval", { id: randomUUID(), version: 1, createdAt: now, updatedAt: now, executionMode: "live",
        taskId, subtaskId: current.review.id, runId: current.reviewRun.id, actionType: "final_delivery", actionDigest: current.digest,
        summary: `Final delivery: ${current.task.title}`, status: "pending", expiresAt: new Date(Date.now() + 30 * 60_000).toISOString(),
        artifactRefs: current.artifacts.map((artifact) => artifact.id), ...(current.artifacts.find((artifact) => artifact.category === "diff") ? { diffArtifactId: current.artifacts.find((artifact) => artifact.category === "diff")!.id } : {}), decidedAt: null, decidedBy: null }, null);
      const task = this.store.get("task", taskId);
      this.store.put("task", { ...task, status: "waiting_approval", pendingApprovalCount: 1, progressPct: Math.min(99, task.progressPct), error: null }, task.version);
      return approval;
    }).immediate();
  }

  async decide(id: string, body: { expectedVersion: number; decision: "approve" | "reject"; actionDigest: string; comment?: string }): Promise<Approval> {
    if (!body || Object.keys(body).some((key) => !["expectedVersion", "decision", "actionDigest", "comment"].includes(key)) || !Number.isSafeInteger(body.expectedVersion) || body.expectedVersion < 1 || !["approve", "reject"].includes(body.decision) || !/^[a-f0-9]{64}$/i.test(body.actionDigest) || (body.comment !== undefined && (typeof body.comment !== "string" || body.comment.length > 4000))) fail("INVALID_INPUT", "Invalid approval decision");
    const approval = this.store.get("approval", id);
    this.assertDecision(approval, body);
    if (Date.parse(approval.expiresAt) <= Date.now()) { this.closePending(approval, "expired"); fail("CONFLICT", "Approval expired"); }
    let initial: FinalDelivery;
    try {
      initial = this.store.snapshot(() => captureFinalDelivery(this.store, approval.taskId, approval.subtaskId)).data;
      if (initial.digest !== approval.actionDigest || !this.sameRefs(approval, initial)) fail("CONFLICT", "Approval content changed");
      await this.verify(initial.artifacts);
    } catch (error) { this.closePending(approval, "invalidated"); throw error; }
    const outcome = this.store.db.transaction(() => {
      const pending = this.store.get("approval", id); this.assertDecision(pending, body);
      if (Date.parse(pending.expiresAt) <= Date.now()) return { stale: "expired" as const };
      let current: FinalDelivery;
      try { current = captureFinalDelivery(this.store, pending.taskId, pending.subtaskId); }
      catch { return { stale: "invalidated" as const }; }
      if (current.digest !== initial.digest || current.digest !== pending.actionDigest || !this.sameRefs(pending, current)) return { stale: "invalidated" as const };
      const decided = this.store.put("approval", { ...pending, status: body.decision === "approve" ? "approved" : "rejected", decidedAt: new Date().toISOString(), decidedBy: "user:local" }, pending.version);
      const now = new Date().toISOString();
      this.store.put("message", { id: randomUUID(), version: 1, createdAt: now, updatedAt: now, executionMode: "live", provenance: "current",
        taskId: pending.taskId, fromRunId: null, toSubtaskId: pending.subtaskId, fromLabel: "user:local", toLabel: "orchestrator",
        kind: "human_directive", summary: body.decision === "approve" ? "Approved final delivery" : "Rejected final delivery",
        content: JSON.stringify({ approvalId: id, decision: body.decision, actionDigest: body.actionDigest, comment: body.comment ?? "" }),
        correlationId: id, causationId: null, artifactRefs: pending.artifactRefs, deliveredAt: now }, null);
      if (body.decision === "approve") {
        const review = this.store.get("subtask", pending.subtaskId);
        this.store.put("subtask", { ...review, status: "succeeded", progressPct: 100 }, review.version);
        this.store.finalizeTask(pending.taskId, id, pending.actionDigest, current.task.version);
      } else {
        const task = this.store.get("task", pending.taskId);
        this.store.put("task", { ...task, pendingApprovalCount: rows<Approval>(this.store, "approval", task.id).filter((item) => item.status === "pending").length }, task.version);
      }
      return { decided };
    }).immediate();
    if (outcome.stale !== undefined) { this.closePending(approval, outcome.stale); fail("CONFLICT", "Approval changed or expired during verification"); }
    return outcome.decided;
  }
  private assertDecision(approval: Approval, body: { expectedVersion: number; actionDigest: string }): void {
    if (approval.version !== body.expectedVersion || approval.status !== "pending" || approval.actionType !== "final_delivery" || approval.actionDigest !== body.actionDigest) fail("CONFLICT", "Approval version, state or digest does not match");
  }
  private sameRefs(approval: Approval, delivery: FinalDelivery): boolean {
    return canonical([...approval.artifactRefs].sort()) === canonical(delivery.artifacts.map((artifact) => artifact.id).sort()) && approval.runId === delivery.reviewRun.id;
  }
  private async verify(artifacts: Artifact[]): Promise<void> {
    try { for (const artifact of artifacts) await this.options.verifyArtifact(artifact); }
    catch { fail("ARTIFACT_INVALID", "Immutable artifact verification failed"); }
  }
  private closePending(approval: Approval, status: "expired" | "invalidated"): void {
    this.store.db.transaction(() => {
      const current = this.store.get("approval", approval.id);
      if (current.version !== approval.version || current.status !== "pending") return;
      const task = this.store.get("task", current.taskId);
      if (task.provenance !== "current" || task.executionMode !== "live") return;
      this.store.put("approval", { ...current, status }, current.version);
      this.store.put("task", { ...task, pendingApprovalCount: rows<Approval>(this.store, "approval", task.id).filter((item) => item.status === "pending").length }, task.version);
    }).immediate();
  }
  private invalidateTaskApprovals(taskId: string): void {
    const task = this.store.get("task", taskId);
    if (task.provenance !== "current" || task.executionMode !== "live") return;
    for (const approval of rows<Approval>(this.store, "approval", taskId)) if (approval.status === "pending" && approval.actionType === "final_delivery") this.closePending(approval, "invalidated");
  }
}
