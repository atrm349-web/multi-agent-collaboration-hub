+  reconcileInterruptedValidations(): string[] {
+    return this.db.transaction(() => {
+      const rows = this.db.query<{ id: string; run_id: string | null },[]>(
+        `SELECT s.id AS id,
+           (SELECT r.id FROM hub_entities r
+              WHERE r.kind='run' AND json_extract(r.data,'$.subtaskId')=s.id
