+           FROM hub_entities s
+          WHERE s.kind='subtask' AND json_extract(s.data,'$.status')='validating'
+            AND NOT EXISTS (SELECT 1 FROM hub_entities r
+                              WHERE r.kind='run' AND json_extract(r.data,'$.subtaskId')=s.id
